# URL publique du site (sans slash final) — canonical, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://piedanna.dev

# Mentions légales (micro-entreprise) — visibles publiquement
NEXT_PUBLIC_LEGAL_SIRET=
NEXT_PUBLIC_LEGAL_ADDRESS=Toulouse, France

# Destinataire des messages du formulaire
CONTACT_TO_EMAIL=hugo@piedanna.dev

# Expéditeur (doit être autorisé par ton serveur SMTP)
CONTACT_FROM_EMAIL=Contact <hugo@piedanna.dev>

# Serveur SMTP
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465 (SSL), false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# https://www.google.com/recaptcha/admin (reCAPTCHA v2 « Je ne suis pas un robot »)
# Ajoute ton domaine de prod dans les domaines autorisés reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
